{
	"name": "mabillon",
	"version": "0.7.2",
	"description": "Agentic transcription and schema-validated structured extraction for historical sources, built on the pi agent harness.",
	"type": "module",
	"license": "MIT",
	"author": "Paul Goetz",
	"bin": {
		"mabillon": "dist/bin.js"
	},
	"files": [
		"dist",
		"schemas",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check": "biome check --error-on-warnings . && tsc --noEmit",
		"test": "vitest --run",
		"prepare": "npm run build",
		"format": "biome check --write ."
	},
	"dependencies": {
		"@earendil-works/pi-ai": "1.0.0",
		"@earendil-works/pi-coding-agent": "1.0.0",
		"@napi-rs/canvas": "1.0.10",
		"ajv": "8.20.0",
		"fflate": "0.8.3",
		"mammoth": "1.13.0",
		"pdfjs-dist": "6.3.289",
		"sharp": "0.35.5",
		"turndown": "7.2.4",
		"typebox": "1.3.27",
		"yaml": "2.9.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "22.19.19",
		"@types/turndown": "5.0.6",
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	}
}
